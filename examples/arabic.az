// Arabic keywords and identifiers use the same compiler pipeline.
دالة مجموع(حد: رقم) -> رقم {
    متغير عدد: رقم = ١;
    متغير نتيجة: رقم = ٠;
    طالما (عدد <= حد) {
        نتيجة = نتيجة + عدد;
        عدد = عدد + ١;
    }
    ارجع نتيجة;
}

دالة بداية() -> فراغ {
    اطبع("مجموع الأعداد من ١ إلى ١٠");
    اطبع(مجموع(١٠));
}
